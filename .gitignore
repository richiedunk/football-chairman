# Capacitor native projects ARE committed — they hold real configuration
# (Info.plist, AndroidManifest, icons, orientation locks) that would be lost
# on every regeneration. Only their build output is ignored.
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/local.properties
android/.idea/
android/captures/
*.iml

# Seeded design canvas payload (2MB, regenerate with seed-canvas.mjs)
design/director-of-football-ui.html

# Mutation testing: the sandbox Stryker copies the project into, and the HTML
# report and incremental state it writes. Both are regenerated by a run.
.stryker-tmp/
reports/

# Agent worktrees are checkouts of this same repo, not content.
.claude/worktrees/
